w":2240,"h":1570},"r-video-qa":{"src":"screening/img/r-video-qa.png","w":2240,"h":1090},"r-interview":{"src":"screening/img/r-interview.png","w":2240,"h":1410},"r-probes":{"src":"screening/img/r-probes.png","w":2240,"h":720}},"cues":[{"text":"Through realistic, role-specific tasks,","start":14.08,"end":16.94},{"text":"it evaluates candidates across four dimensions:","start":16.94,"end":20.1},{"text":"Candidates tackle these tasks","start":25.11,"end":26.71},{"text":"in a dedicated workspace","start":26.71,"end":28.13},{"text":"with AI coding tools such as Claude Code,","start":28.13,"end":31.63},{"text":"Codex, GitHub Copilot, and more built in.","start":31.63,"end":34.75},{"text":"As they work through real challenges,","start":34.75,"end":37.27},{"text":"VibeLevel looks beyond the","start":37.27,"end":38.57},{"text":"final output to understand","start":38.57,"end":40.29},{"text":"how they solve problems and collaborate with AI.","start":40.29,"end":43.22},{"text":"First,","start":44.21,"end":45.05},{"text":"Core Skills shows how well candidates apply","start":45.05,"end":47.35},{"text":"their technical knowledge to the task.","start":47.35,"end":49.71},{"text":"Working with AI reveals","start":49.71,"end":51.01},{"text":"how effectively they guide AI,","start":51.01,"end":53.53},{"text":"evaluate its suggestions, and verify the results.","start":53.53,"end":56.46},{"text":"Ownership reveals how candidates take","start":60.63,"end":62.79},{"text":"responsibility for their decisions,","start":62.79,"end":65.17},{"text":"while Human Contribution highlights the judgment","start":65.17,"end":67.71},{"text":"and value they bring beyond AI-generated output.","start":67.71,"end":71.3},{"text":"To evaluate the right skills,","start":72.23,"end":74.15},{"text":"recruiters can start","start":74.15,"end":75.15},{"text":"with ready-made assessment templates,","start":75.15,"end":77.55},{"text":"customize them to their role requirements,","start":77.55,"end":79.87},{"text":"or use AI to create assessments","start":79.87,"end":82.03},{"text":"by simply describing what they need.","start":82.03,"end":84.79},{"text":"And these assessments can integrate","start":84.79,"end":86.45},{"text":"with ATS platforms such as Lever and Ashby,","start":86.45,"end":90.23},{"text":"fitting directly into their","start":90.23,"end":91.47},{"text":"existing hiring workflow.","start":91.47,"end":93.06},{"text":"Once candidates complete their assessments,","start":93.92,"end":96.54},{"text":"recruiters get a clearer picture of","start":96.54,"end":98.2},{"text":"their performance through skill scores,","start":98.2,"end":100.46},{"text":"AI collaboration insights, Code Review,","start":100.46,"end":103.48},{"text":"and Video Q&A.","start":103.48,"end":105},{"text":"The Interview Guide then turns those findings","start":105,"end":107.58},{"text":"into focused follow-up questions,","start":107.58,"end":109.96},{"text":"helping recruiters explore strengths","start":109.96,"end":111.84},{"text":"and gaps in greater depth.","start":111.84,"end":113.49}],"musicOffset":4.5}