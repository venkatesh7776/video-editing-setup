// The Digital Moments — "How Moments QR works" (16:9, ~1:30), projects/qr-howitworks.
// Brand (the-digital-moments.vercel.app): blush-ivory surfaces, warm near-black ink, gold gradient accents, Manrope;
// the gold "Dm" play-swoosh logo with "The Digital Moments" set beneath it. Founder: Venkatesh Yarramsetti.
// Steps: create folder + QR → place it & guests scan → guest uploads → it lands in the (included) wedding website.
// All timing comes from the ElevenLabs word timings (props.parts).
import {loadFont as loadManrope} from '@remotion/google-fonts/Manrope';
import React from 'react';
import {AbsoluteFill, Audio, Easing, Img, interpolate, OffthreadVideo, Sequence, staticFile, useCurrentFrame, type CalculateMetadataFunction} from 'remotion';
import {IPhone15, SCR_H, SCR_W} from './Memories';

const font = loadManrope('normal', {weights: ['400', '500', '600', '700', '800'], subsets: ['latin']}).fontFamily;

const FPS = 30;
const B = {
	bg: '#F9F4F1',
	bg2: '#F3E8E0',
	card: '#FFFFFF',
	ink: '#231B17',
	muted: '#6F625A',
	line: '#EADFD6',
	copper: '#B9773A',
	gold: '#D9A045',
	goldLight: '#F0C46A',
	goldDeep: '#A9681F',
	dark: '#231C17',
	maroon: '#651E2B',
};
const GOLD_TEXT: React.CSSProperties = {background: `linear-gradient(100deg, ${B.goldLight} 0%, ${B.gold} 40%, ${B.goldDeep} 100%)`, WebkitBackgroundClip: 'text', backgroundClip: 'text', color: 'transparent'};

type Word = {w: string; s: number; e: number};
type Part = {id: string; start: number; end: number; words: Word[]};
export type HiwProps = {parts: Part[]; duration: number; segments: {s: number; e: number}[]; musicOffset: number};
export const calculateHiwMetadata: CalculateMetadataFunction<HiwProps> = ({props}) => ({fps: FPS, durationInFrames: Math.max(1, Math.ceil(props.duration * FPS))});

const SOFT = Easing.bezier(0.25, 0.1, 0.25, 1);
const IN_OUT = Easing.bezier(0.65, 0, 0.35, 1);
const POP = Easing.bezier(0.3, 1.5, 0.5, 1);
const prog = (t: number, a: number, d: number, e: (x: number) => number = SOFT) => interpolate(t, [a, a + d], [0, 1], {extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: e});
const mix = (a: number, b: number, p: number) => a + (b - a) * p;
const clean = (w: string) => w.toLowerCase().replace(/[^a-z']/g, '');

const useTimes = (parts: Part[]) => {
	const P = (id: string) => parts.find((p) => p.id === id) ?? {id, start: 0, end: 0, words: []};
	const W = (id: string, word: string, k = 0) => {
		const hits = P(id).words.filter((w) => clean(w.w).startsWith(word));
		return (hits[k] ?? hits[hits.length - 1] ?? {s: P(id).start}).s;
	};
	return {P, W};
};
type T = ReturnType<typeof useTimes>;
type SP = {t: number; c: T; a: number; b: number};

// ── brand pieces ────────────────────────────────────────────────────────────────────────────────────

const LOGO_AR = 1334 / 753;
const Logo: React.FC<{h: number; style?: React.CSSProperties}> = ({h, style}) => <Img src={staticFile('qrh/img/tdm-logo.png')} style={{height: h, width: h * LOGO_AR, ...style}} />;

/** A tiny four-point gold star (the logo's sparkle). */
const Star: React.FC<{size: number; color?: string; style?: React.CSSProperties}> = ({size, color = B.gold, style}) => (
	<svg viewBox="-10 -10 20 20" width={size} height={size} style={style}>
		<path d="M0 -10 C1 -3 3 -1 10 0 C3 1 1 3 0 10 C-1 3 -3 1 -10 0 C-3 -1 -1 -3 0 -10 Z" fill={color} />
	</svg>
);

const Backdrop: React.FC<{t: number}> = ({t}) => (
	<AbsoluteFill style={{background: B.bg}}>
		<AbsoluteFill style={{background: 'radial-gradient(ellipse 60% 55% at 50% -5%, rgba(246,222,200,0.75), rgba(249,244,241,0) 70%), radial-gradient(ellipse 40% 50% at 100% 100%, rgba(240,214,190,0.45), rgba(249,244,241,0) 70%)'}} />
		{[
			[180, 860, 14, 0],
			[880, 140, 10, 1.3],
			[1830, 200, 16, 2.1],
			[1010, 980, 12, 0.7],
			[90, 330, 9, 2.8],
			[1880, 760, 11, 1.9],
		].map(([x, y, s, ph], i) => (
			<Star key={i} size={s} color={B.gold} style={{position: 'absolute', left: x, top: y, opacity: 0.18 + 0.32 * (0.5 + 0.5 * Math.sin(t * 1.6 + ph * 2))}} />
		))}
	</AbsoluteFill>
);

const Corner: React.FC<{o: number}> = ({o}) => (
	<div style={{position: 'absolute', left: 64, top: 40, display: 'flex', alignItems: 'center', gap: 14, opacity: o}}>
		<Logo h={46} />
		<div style={{fontFamily: font, fontWeight: 700, fontSize: 24, color: B.ink, letterSpacing: '-0.01em'}}>The Digital Moments</div>
	</div>
);

const STEPS = ['Create & generate', 'Place & scan', 'Guests upload', 'Your website'];
const Tracker: React.FC<{active: number; o: number}> = ({active, o}) => (
	<div style={{position: 'absolute', left: 64, bottom: 44, display: 'flex', gap: 10, opacity: o}}>
		{STEPS.map((s, i) => {
			const on = i === active;
			const done = i < active;
			return (
				<div key={s} style={{display: 'flex', alignItems: 'center', gap: 10, padding: '10px 18px 10px 10px', borderRadius: 999, background: on ? B.dark : 'rgba(255,255,255,0.7)', boxShadow: on ? 'none' : `inset 0 0 0 1px ${B.line}`}}>
					<div style={{width: 30, height: 30, borderRadius: '50%', background: on ? `linear-gradient(135deg, ${B.goldLight}, ${B.goldDeep})` : done ? '#F1E2CC' : '#EFE7E1', display: 'flex', alignItems: 'center', justifyContent: 'center', fontFamily: font, fontWeight: 800, fontSize: 15, color: on ? B.dark : done ? B.goldDeep : B.muted}}>
						{done ? '✓' : i + 1}
					</div>
					<div style={{fontFamily: font, fontWeight: on ? 700 : 500, fontSize: 19, color: on ? '#FFF7EE' : B.muted}}>{s}</div>
				</div>
			);
		})}
	</div>
);

const Eyebrow: React.FC<{children: React.ReactNode; p: number; color?: string}> = ({children, p, color = B.copper}) => (
	<div style={{display: 'flex', alignItems: 'center', gap: 10, fontFamily: font, fontWeight: 700, fontSize: 21, letterSpacing: '0.22em', textTransform: 'uppercase', color, opacity: p, transform: `translateY(${(1 - p) * 14}px)`}}>
		<Star size={16} color={B.gold} />
		{children}
	</div>
);

/** Left column: step eyebrow, headline, and a checklist whose items arrive on the voice. */
const StepText: React.FC<{t: number; a: number; eyebrow: string; title: React.ReactNode; items: [number, string][]; top?: number; out?: number}> = ({t, a, eyebrow, title, items, top = 230, out = 1e9}) => {
	const o = 1 - prog(t, out, 0.35);
	const latest = items.filter(([at]) => t >= at - 0.1).length - 1;
	return (
		<div style={{position: 'absolute', left: 140, width: 760, top, opacity: o}}>
			<Eyebrow p={prog(t, a + 0.15, 0.5)}>{eyebrow}</Eyebrow>
			<div style={{marginTop: 22, fontFamily: font, fontWeight: 800, fontSize: 66, lineHeight: 1.06, letterSpacing: '-0.03em', color: B.ink, opacity: prog(t, a + 0.25, 0.6), transform: `translateY(${(1 - prog(t, a + 0.25, 0.6)) * 24}px)`}}>{title}</div>
			<div style={{marginTop: 46, display: 'flex', flexDirection: 'column', gap: 18}}>
				{items.map(([at, label], i) => {
					const p = prog(t, at - 0.12, 0.45);
					const on = i === latest;
					return (
						<div key={label} style={{display: 'flex', alignItems: 'center', gap: 18, opacity: p * (on ? 1 : 0.62), transform: `translateX(${(1 - p) * -24}px)`}}>
							<div style={{width: 40, height: 40, borderRadius: '50%', flexShrink: 0, background: `linear-gradient(135deg, ${B.goldLight}, ${B.goldDeep})`, display: 'flex', alignItems: 'center', justifyContent: 'center', transform: `scale(${mix(0.5, 1, prog(t, at - 0.12, 0.4, POP))})`}}>
								<svg viewBox="0 0 24 24" width={22} height={22} fill="none" stroke="#fff" strokeWidth={3} strokeLinecap="round" strokeLinejoin="round">
									<path d="M5 12.5l4.5 4.5L19 7.5" />
								</svg>
							</div>
							<div style={{fontFamily: font, fontWeight: on ? 700 : 500, fontSize: 34, color: B.ink, letterSpacing: '-0.01em'}}>{label}</div>
						</div>
					);
				})}
			</div>
		</div>
	);
};

// ── phone + recordings ─────────────────────────────────────────────────────────────────────────────

const PH = 880; // screen height in the 16:9 frame
const PX = 1330; // phone centre x
const PY = 100; // screen top
/** A recording time-mapped onto the reel: keys are [reelTime, srcTime]; each span plays at its own speed. */
const Mapped: React.FC<{s: number; src: string; keys: [number, number][]}> = ({s, src, keys}) => {
	const k: [number, number][] = [];
	for (const [r, x] of keys) k.push([k.length ? Math.max(r, k[k.length - 1][0] + 0.25) : r, x]);
	return (
		<>
			{k.slice(0, -1).map(([r0, s0], i) => {
				const [r1, s1] = k[i + 1];
				const rate = Math.max(0.08, (s1 - s0) / (r1 - r0));
				return (
					<Sequence key={i} from={Math.round(r0 * FPS)} durationInFrames={Math.max(1, Math.round((r1 - r0) * FPS))} layout="none">
						<OffthreadVideo src={staticFile(`qrh/${src}`)} startFrom={Math.round(s0 * FPS)} playbackRate={rate} muted style={{position: 'absolute', left: 0, top: 0, width: SCR_W * s, height: SCR_H * s, objectFit: 'cover'}} />
					</Sequence>
				);
			})}
		</>
	);
};
const Still: React.FC<{s: number; src: string; o?: number}> = ({s, src, o = 1}) => <Img src={staticFile(`qrh/img/${src}`)} style={{position: 'absolute', left: 0, top: 0, width: SCR_W * s, height: SCR_H * s, objectFit: 'cover', opacity: o}} />;

const Callout: React.FC<{t: number; at: number; until?: number; x: number; y: number; children: React.ReactNode}> = ({t, at, until = 1e9, x, y, children}) => {
	const p = prog(t, at, 0.45, POP) * (1 - prog(t, until, 0.3));
	if (p <= 0) return null;
	return (
		<div style={{position: 'absolute', left: x, top: y, padding: '12px 20px', borderRadius: 14, background: B.dark, color: '#FFF7EE', fontFamily: font, fontWeight: 600, fontSize: 22, boxShadow: '0 20px 40px -18px rgba(35,27,23,0.6)', display: 'flex', alignItems: 'center', gap: 10, opacity: Math.min(1, p * 1.5), transform: `scale(${mix(0.85, 1, p)})`, transformOrigin: 'left center', whiteSpace: 'nowrap'}}>
			<Star size={16} color={B.goldLight} />
			{children}
		</div>
	);
};

// ── scenes ──────────────────────────────────────────────────────────────────────────────────────────

/** 0 · logo, founder, title */
const SceneIntro: React.FC<SP> = ({t, c, a}) => {
	const tHi = c.W('h0', 'hi');
	const tLet = c.W('h0', 'let');
	const logoIn = prog(t, a + 0.15, 1.1);
	const logoOut = prog(t, tHi - 0.45, 0.55, IN_OUT);
	const glow = Math.sin(Math.PI * prog(t, a + 0.9, 1.0));
	const founder = prog(t, tHi - 0.2, 0.7);
	const side = prog(t, tLet - 0.3, 0.8, IN_OUT);
	const title = prog(t, tLet - 0.05, 0.7);
	return (
		<AbsoluteFill>
			{logoOut < 1 ? (
				<div style={{position: 'absolute', left: 0, right: 0, top: 250, display: 'flex', flexDirection: 'column', alignItems: 'center', opacity: logoIn * (1 - logoOut), transform: `scale(${mix(0.9, 1, logoIn) * mix(1, 0.85, logoOut)})`, filter: `blur(${(1 - logoIn) * 10}px)`}}>
					<div style={{position: 'relative'}}>
						<Logo h={330} />
						<div style={{position: 'absolute', left: 0.79 * 330 * LOGO_AR - 120, top: 0.17 * 330 - 120, width: 240, height: 240, borderRadius: '50%', background: 'radial-gradient(circle, rgba(255,226,150,0.9), rgba(255,226,150,0) 60%)', opacity: glow, mixBlendMode: 'screen'}} />
					</div>
					<div style={{marginTop: 26, fontFamily: font, fontWeight: 700, fontSize: 64, letterSpacing: '-0.02em', color: B.ink}}>The Digital Moments</div>
				</div>
			) : null}
			{/* founder */}
			{founder > 0 ? (
				<div style={{position: 'absolute', left: mix(960, 500, side) - 380, top: 220, width: 760, display: 'flex', flexDirection: 'column', alignItems: 'center', opacity: founder, transform: `translateY(${(1 - founder) * 30}px)`}}>
					<div style={{width: 380, height: 380, borderRadius: '50%', padding: 8, background: `linear-gradient(135deg, ${B.goldLight}, ${B.goldDeep})`, boxShadow: '0 40px 70px -30px rgba(120,70,20,0.55)'}}>
						<Img src={staticFile('qrh/img/founder.png')} style={{width: 364, height: 364, borderRadius: '50%', display: 'block'}} />
					</div>
					<div style={{marginTop: 36, fontFamily: font, fontWeight: 800, fontSize: 50, letterSpacing: '-0.02em', color: B.ink, textAlign: 'center'}}>Venkatesh Yarramsetti</div>
					<div style={{marginTop: 8, fontFamily: font, fontWeight: 600, fontSize: 26, letterSpacing: '0.04em', color: B.copper}}>Founder, The Digital Moments</div>
				</div>
			) : null}
			{/* title */}
			{title > 0 ? (
				<div style={{position: 'absolute', left: 900, width: 900, top: 290, opacity: title, transform: `translateX(${(1 - title) * 40}px)`}}>
					<Eyebrow p={title}>Moments QR</Eyebrow>
					<div style={{marginTop: 18, fontFamily: font, fontWeight: 800, fontSize: 132, lineHeight: 1, letterSpacing: '-0.04em', color: B.ink}}>
						How it <span style={GOLD_TEXT}>works</span>
					</div>
					<div style={{marginTop: 46, display: 'flex', flexDirection: 'column', gap: 18}}>
						{[
							[c.W('h0', 'qr', 1), 'A QR code at your wedding'],
							[c.W('h0', 'very'), 'Your very own wedding website'],
						].map(([at, label], i) => {
							const p = prog(t, (at as number) - 0.1, 0.5, POP);
							return (
								<div key={i} style={{display: 'flex', alignItems: 'center', gap: 16, alignSelf: 'flex-start', padding: '16px 28px 16px 18px', borderRadius: 999, background: '#fff', boxShadow: `inset 0 0 0 1px ${B.line}, 0 16px 30px -18px rgba(120,70,20,0.35)`, opacity: Math.min(1, p * 1.5), transform: `scale(${mix(0.85, 1, p)})`, transformOrigin: 'left center'}}>
									<div style={{width: 44, height: 44, borderRadius: '50%', background: `linear-gradient(135deg, ${B.goldLight}, ${B.goldDeep})`, display: 'flex', alignItems: 'center', justifyContent: 'center', fontFamily: font, fontWeight: 800, fontSize: 20, color: '#fff'}}>{i === 0 ? 'QR' : '♡'}</div>
									<div style={{fontFamily: font, fontWeight: 600, fontSize: 32, color: B.ink}}>{label as string}</div>
								</div>
							);
						})}
					</div>
				</div>
			) : null}
		</AbsoluteFill>
	);
};

/** 1 · create the folder, generate the QR card */
const SceneCreate: React.FC<SP> = ({t, c, a, b}) => {
	const W = (w: string, k = 0) => c.W('h1', w, k);
	const phone = prog(t, a + 0.1, 0.8);
	return (
		<AbsoluteFill>
			<StepText
				t={t}
				a={a}
				eyebrow="Step 1 · For the couple"
				title={
					<>
						Create a folder,
						<br />
						get your <span style={GOLD_TEXT}>QR card</span>
					</>
				}
				items={[
					[W('create'), 'A folder for each event'],
					[W('add'), 'Add the date'],
					[W('generate'), 'Tap “Generate QR code”'],
					[W('beautiful'), 'A card in your wedding’s theme'],
					[W('edit'), 'Edit the words & download'],
				]}
			/>
			<IPhone15 x={PX} y={PY} h={PH} p={phone} rec={false} shadow="120,70,20">
				{(s) => (
					<Mapped
						s={s}
						src="folder.mp4"
						keys={[
							[a, 0],
							[W('open') + 0.5, 0.9],
							[W('reception') + 0.4, 4.6],
							[W('add') + 0.9, 8.2],
							[W('ready') + 0.3, 13.6],
							[W('generate') + 0.5, 15.8],
							[W('beautiful') + 1.4, 19.6],
							[W('edit') + 1.0, 22.2],
							[W('download') + 0.6, 26.9],
							[b + 1.2, 28.6],
						]}
					/>
				)}
			</IPhone15>
			<Callout t={t} at={W('reception')} until={W('add') + 0.9} x={PX + 255} y={300}>
				Reception
			</Callout>
			<Callout t={t} at={W('generate') + 0.1} until={W('beautiful') + 0.6} x={PX + 255} y={620}>
				Generate QR code
			</Callout>
			<Callout t={t} at={W('download') + 0.2} x={PX + 255} y={760}>
				Download · PNG
			</Callout>
		</AbsoluteFill>
	);
};

/** 2 · place the card at the venue; a guest scans it */
const SceneScan: React.FC<SP> = ({t, c, a}) => {
	const W = (w: string, k = 0) => c.W('h2', w, k);
	const panel = prog(t, a + 0.1, 0.8);
	const card = prog(t, W('print') - 0.1, 0.9, Easing.bezier(0.2, 0.9, 0.3, 1));
	const tScan = W('scan');
	const phone = prog(t, tScan - 0.35, 0.8, Easing.bezier(0.2, 0.9, 0.3, 1));
	const lock = prog(t, W('camera') - 0.1, 0.55, IN_OUT);
	const banner = prog(t, W('camera') + 0.45, 0.45, POP);
	const opened = prog(t, W('no') + 0.15, 0.4);
	const PX2 = 960;
	const PW = 880;
	return (
		<AbsoluteFill>
			<StepText
				t={t}
				a={a}
				eyebrow="Step 2 · At the wedding"
				title={
					<>
						Place it at your venue,
						<br />
						guests <span style={GOLD_TEXT}>scan</span>
					</>
				}
				items={[
					[W('print'), 'Print your QR card'],
					[W('entrance'), 'At the entrance or on every table'],
					[W('scan'), 'Guests scan with their camera'],
					[W('no'), 'No app. No login.'],
				]}
			/>
			{/* the venue */}
			<div style={{position: 'absolute', left: PX2, top: 100, width: PW, height: 880, borderRadius: 28, overflow: 'hidden', opacity: panel, transform: `translateX(${(1 - panel) * 60}px)`, boxShadow: '0 50px 90px -40px rgba(80,45,20,0.55)'}}>
				<Sequence from={Math.round(a * FPS)} layout="none">
					<OffthreadVideo src={staticFile('qrh/a2.mp4')} muted style={{position: 'absolute', left: -60, top: -60, width: PW + 120, height: 880 + 120, objectFit: 'cover', filter: 'blur(16px) brightness(0.72) saturate(1.05)'}} />
				</Sequence>
				<AbsoluteFill style={{background: 'linear-gradient(to bottom, rgba(35,27,23,0.1), rgba(35,27,23,0.35))'}} />
				{/* the printed card on a gold easel */}
				<div style={{position: 'absolute', left: PW / 2 - 230, top: 90, width: 460, height: 700, opacity: card, transform: `translateY(${(1 - card) * 80}px) scale(${mix(0.92, 1, card) * mix(1, 0.9, phone)})`, transformOrigin: '50% 60%'}}>
					<div style={{position: 'absolute', left: 60, top: 560, width: 10, height: 150, background: `linear-gradient(${B.goldLight}, ${B.goldDeep})`, transform: 'rotate(12deg)', borderRadius: 4}} />
					<div style={{position: 'absolute', right: 60, top: 560, width: 10, height: 150, background: `linear-gradient(${B.goldLight}, ${B.goldDeep})`, transform: 'rotate(-12deg)', borderRadius: 4}} />
					<Img src={staticFile('qrh/img/qr-card.png')} style={{position: 'absolute', left: 0, top: 0, width: 460, height: 613, borderRadius: 6, boxShadow: '0 30px 60px -20px rgba(0,0,0,0.6), 0 0 0 6px #F7EBDD, 0 0 0 8px rgba(201,150,70,0.8)'}} />
				</div>
				<div style={{position: 'absolute', left: 36, top: 36, padding: '10px 18px', borderRadius: 999, background: 'rgba(255,255,255,0.88)', fontFamily: font, fontWeight: 700, fontSize: 20, color: B.ink, opacity: prog(t, W('entrance') - 0.1, 0.4)}}>Reception · Entrance</div>
			</div>
			{/* a guest's phone camera */}
			{phone > 0 ? (
				<IPhone15 x={PX2 + PW - 170} y={mix(1150, 330, phone)} h={620} p={1} rec={false} shadow="40,20,10">
					{(s) => {
						const sw = SCR_W * s;
						const sh = SCR_H * s;
						const cw = sw * 1.75; // card width in the viewfinder: the QR fills ~64% of the screen
						const ch = cw * (3200 / 2400);
						const jx = Math.sin(t * 2.3) * 4 * (1 - lock);
						const jy = Math.cos(t * 1.9) * 5 * (1 - lock);
						return (
							<>
								<div style={{position: 'absolute', inset: 0, background: '#120C0A'}} />
								<Img src={staticFile('qrh/img/qr-card.png')} style={{position: 'absolute', left: sw / 2 - cw * 0.5 + jx, top: sh * 0.47 - ch * 0.569 + jy, width: cw, height: ch, filter: 'brightness(0.92)'}} />
								<div style={{position: 'absolute', inset: 0, background: 'radial-gradient(ellipse 70% 55% at 50% 47%, rgba(0,0,0,0) 55%, rgba(0,0,0,0.45))'}} />
								{/* QR lock brackets */}
								{(() => {
									const sz = sw * mix(0.92, 0.7, lock);
									const x0 = sw / 2 - sz / 2;
									const y0 = sh * 0.47 - sz / 2;
									const L = sz * 0.22;
									const st = {position: 'absolute' as const, width: L, height: L, borderColor: '#FFD43B', borderStyle: 'solid', borderWidth: 0};
									return (
										<>
											<div style={{...st, left: x0, top: y0, borderTopWidth: 5, borderLeftWidth: 5, borderTopLeftRadius: 12}} />
											<div style={{...st, left: x0 + sz - L, top: y0, borderTopWidth: 5, borderRightWidth: 5, borderTopRightRadius: 12}} />
											<div style={{...st, left: x0, top: y0 + sz - L, borderBottomWidth: 5, borderLeftWidth: 5, borderBottomLeftRadius: 12}} />
											<div style={{...st, left: x0 + sz - L, top: y0 + sz - L, borderBottomWidth: 5, borderRightWidth: 5, borderBottomRightRadius: 12}} />
										</>
									);
								})()}
								{/* camera's link banner */}
								{banner > 0 ? (
									<div style={{position: 'absolute', left: sw / 2 - sw * 0.4, top: sh * 0.47 + sw * 0.42, width: sw * 0.8, padding: `${12 * s * 2}px ${18 * s * 2}px`, borderRadius: 22 * s * 2, background: 'rgba(255,212,59,0.95)', display: 'flex', alignItems: 'center', gap: 10 * s * 2, transform: `scale(${mix(0.8, 1, banner)})`, opacity: Math.min(1, banner * 1.4), boxSizing: 'border-box'}}>
										<div style={{fontFamily: 'Helvetica Neue, Arial', fontWeight: 600, fontSize: 22 * s * 2, color: '#1A1A1A', lineHeight: 1.2}}>
											Website QR code
											<div style={{fontWeight: 400, fontSize: 19 * s * 2}}>wedding-memories-iota.vercel.app</div>
										</div>
									</div>
								) : null}
								{opened > 0 ? <Still s={s} src="upload-start.png" o={opened} /> : null}
							</>
						);
					}}
				</IPhone15>
			) : null}
		</AbsoluteFill>
	);
};

/** 3 · the guest's upload: photos, note, reaction, voice note, name, Share → Thank you */
const NOTE = 'Wishing you both a lifetime of love & laughter!';
const SceneUpload: React.FC<SP> = ({t, c, a, b}) => {
	const W = (w: string, k = 0) => c.W('h3', w, k);
	const phone = prog(t, a + 0.1, 0.7);
	const tPick = W('pick');
	const tNote = W('write');
	const tReact = W('reaction');
	const tVoice = W('voice');
	const tOne = W('one');
	const fStart = W('pick') + 1.9; // form appears (photo added)
	const freeze = fStart + 0.9;
	const shareAt = tOne - 0.1;
	const FIELD = {x: 84, y: 752, w: 718};
	const HEART = [133, 1075] as const;
	const LOVE = [367, 1075] as const;
	const VOICE = {x: 86, y: 1300, w: 714, h: 160, mic: [176, 1380] as const};
	const typed = Math.round(prog(t, tNote - 0.05, 1.2, Easing.linear) * NOTE.length);
	const rec = prog(t, tVoice - 0.1, 0.3);
	const recSec = Math.max(0, t - (tVoice - 0.1));
	const sel = (at: number) => prog(t, at, 0.35, POP);
	return (
		<AbsoluteFill>
			<StepText
				t={t}
				a={a}
				eyebrow="Step 3 · For your guests"
				title={
					<>
						Guests share
						<br />
						<span style={GOLD_TEXT}>more than photos</span>
					</>
				}
				items={[
					[tPick, 'Their photos'],
					[tNote, 'A little note for you'],
					[tReact, 'A reaction'],
					[tVoice, 'A voice message'],
					[W('name'), 'Their name (optional)'],
					[W('share'), 'One tap on Share'],
				]}
			/>
			<IPhone15 x={PX} y={PY} h={PH} p={phone} shadow="120,70,20">
				{(s) => (
					<>
						<Mapped
							s={s}
							src="r23.mp4"
							keys={[
								[a, 0.0],
								[tPick + 0.5, 0.9],
								[tPick + 0.55, 1.4],
								[fStart, 2.8],
							]}
						/>
						<Mapped
							s={s}
							src="r23.mp4"
							keys={[
								[fStart, 17.9],
								[freeze, 19.2],
							]}
						/>
						{t >= freeze && t < shareAt ? (
							<>
								<Still s={s} src="upload-form.png" />
								{typed > 0 ? (
									<div style={{position: 'absolute', left: FIELD.x * s, top: FIELD.y * s, width: FIELD.w * s, height: 140 * s, background: '#FCF4ED'}}>
										<div style={{fontFamily: 'Cormorant Garamond, Georgia, serif', fontStyle: 'italic', fontSize: 44 * s, lineHeight: `${52 * s}px`, color: '#3A2A2C', paddingTop: 12 * s}}>
											{NOTE.slice(0, typed)}
											<span style={{display: 'inline-block', width: 2.5 * s, height: 44 * s, marginLeft: 2 * s, background: B.maroon, verticalAlign: 'middle', opacity: typed < NOTE.length || Math.floor(t * 2.4) % 2 ? 1 : 0}} />
										</div>
									</div>
								) : null}
								{(
									[
										[HEART[0], HEART[1], sel(tReact - 0.05)],
										[LOVE[0], LOVE[1], sel(tReact + 0.35)],
									] as [number, number, number][]
								).map(([cx, cy, p], i) =>
									p > 0 ? <div key={i} style={{position: 'absolute', left: (cx - 54) * s, top: (cy - 54) * s, width: 108 * s, height: 108 * s, borderRadius: '50%', border: `${4.5 * s}px solid ${B.maroon}`, boxSizing: 'border-box', background: 'rgba(101,30,43,0.07)', transform: `scale(${mix(0.6, 1, p)})`, opacity: Math.min(1, p * 2)}} /> : null,
								)}
								{rec > 0 ? (
									<div style={{position: 'absolute', left: VOICE.x * s, top: VOICE.y * s, width: VOICE.w * s, height: VOICE.h * s, borderRadius: 10 * s, background: '#F7EAE6', boxShadow: `inset 0 0 0 ${2.5 * s}px ${B.maroon}`, opacity: rec}}>
										{[0, 1].map((k) => {
											const ring = (recSec * 0.9 + k * 0.5) % 1;
											return <div key={k} style={{position: 'absolute', left: (VOICE.mic[0] - VOICE.x - 54) * s, top: (VOICE.mic[1] - VOICE.y - 54) * s, width: 108 * s, height: 108 * s, borderRadius: '50%', border: `${3 * s}px solid ${B.maroon}`, transform: `scale(${1 + ring * 0.55})`, opacity: 0.5 * (1 - ring)}} />;
										})}
										<div style={{position: 'absolute', left: (VOICE.mic[0] - VOICE.x - 54) * s, top: (VOICE.mic[1] - VOICE.y - 54) * s, width: 108 * s, height: 108 * s, borderRadius: '50%', background: B.maroon, display: 'flex', alignItems: 'center', justifyContent: 'center'}}>
											<div style={{width: 30 * s, height: 30 * s, borderRadius: 5 * s, background: '#FAF5EC'}} />
										</div>
										<div style={{position: 'absolute', left: 181 * s, top: 34 * s, fontFamily: font, fontWeight: 600, fontSize: 34 * s, color: B.maroon, display: 'flex', alignItems: 'center', gap: 12 * s}}>
											<span style={{width: 16 * s, height: 16 * s, borderRadius: '50%', background: '#C8333F', opacity: Math.floor(t * 2.5) % 2 ? 1 : 0.35}} />
											Recording… 0:0{Math.min(9, Math.floor(recSec))}
										</div>
										<div style={{position: 'absolute', left: 181 * s, top: 92 * s, display: 'flex', alignItems: 'center', gap: 7 * s, height: 40 * s}}>
											{Array.from({length: 34}, (_, k) => {
												const amp = 0.25 + 0.75 * Math.abs(Math.sin(k * 1.7 + t * 9) * Math.sin(k * 0.6 + t * 4.3));
												const on = k / 34 < Math.min(1, recSec / 2.4);
												return <div key={k} style={{width: 7 * s, height: 40 * s * (on ? amp : 0.12), borderRadius: 4 * s, background: on ? '#C5A15B' : '#D9C9B0'}} />;
											})}
										</div>
									</div>
								) : null}
							</>
						) : null}
						<Mapped
							s={s}
							src="r23.mp4"
							keys={[
								[shareAt, 31.9],
								[W('share') + 0.35, 33.3],
								[W('done') - 0.1, 37.7],
								[b + 1.2, 41.2],
							]}
						/>
					</>
				)}
			</IPhone15>
			<Callout t={t} at={W('share') + 0.2} until={W('done') + 0.2} x={PX + 255} y={860}>
				Share your photos
			</Callout>
			<Callout t={t} at={W('done') + 0.1} x={PX + 255} y={300}>
				Sent to the couple’s album
			</Callout>
		</AbsoluteFill>
	);
};

/** 4 · the wedding website (included) and the Wedding Memories albums */
