						[W('scroll') + 0.1, 'Scroll to Wedding Memories'],
						[W('album'), 'An album for each event'],
						[W('captured'), 'Every photo your guests took'],
					]}
				/>
			) : null}
			{/* "website included" badge */}
			{badge > 0 ? (
				<div style={{position: 'absolute', left: PX + 255, top: 150, padding: '12px 22px', borderRadius: 999, background: `linear-gradient(135deg, ${B.goldLight}, ${B.gold} 50%, ${B.goldDeep})`, fontFamily: font, fontWeight: 800, fontSize: 24, color: B.dark, boxShadow: '0 18px 36px -16px rgba(150,90,20,0.6)', transform: `scale(${mix(0.7, 1, badge)}) rotate(${mix(-6, 3, badge)}deg)`, opacity: Math.min(1, badge * 1.5) * (1 - prog(t, tScroll - 0.3, 0.3))}}>Website included ✦</div>
			) : null}
			<IPhone15 x={PX} y={PY} h={PH} p={phone} rec={t < tScroll} shadow="120,70,20">
				{(s) => (
					<>
						{t < tScroll + 0.3 ? (
							<div style={{position: 'absolute', inset: 0, opacity: 1 - prog(t, tScroll - 0.05, 0.3)}}>
								<Mapped
									s={s}
									src="site.mp4"
									keys={[
										[a, 1.4],
										[W('names') + 0.5, 3.4],
										[W('story') + 0.5, 6.4],
										[W('families') + 0.7, 9.4],
										[W('event', 1) + 0.2, 10.6],
										[W('directions') + 0.8, 16.4],
										[W('signature') + 1.0, 21.2],
										[tScroll + 0.3, 22.8],
									]}
								/>
							</div>
						) : null}
						{t >= tScroll - 0.1 ? (
							<div style={{position: 'absolute', inset: 0, opacity: prog(t, tScroll - 0.1, 0.3)}}>
								<Mapped
									s={s}
									src="r22.mp4"
									keys={[
										[tScroll - 0.1, 0.0],
										[W('there') - 0.1, 6.3],
										[W('captured') + 0.4, 12.0],
										[b + 1.2, 17.8],
									]}
								/>
							</div>
						) : null}
					</>
				)}
			</IPhone15>
			<Callout t={t} at={W('there') + 0.1} x={PX + 255} y={560}>
				Shared by your guests
			</Callout>
		</AbsoluteFill>
	);
};

/** 5 · two things in one, then the CTA end card */
const SceneEnd: React.FC<SP> = ({t, c, a}) => {
	const W = (w: string, k = 0) => c.W('h5', w, k);
	const tWant = W('want');
	const out = prog(t, tWant - 0.35, 0.5, IN_OUT);
	const card1 = prog(t, W('codes') - 0.15, 0.7, Easing.bezier(0.2, 0.9, 0.3, 1));
	const card2 = prog(t, W('own') - 0.15, 0.7, Easing.bezier(0.2, 0.9, 0.3, 1));
	const end = prog(t, tWant - 0.1, 0.7);
	const cta = prog(t, W('message') - 0.1, 0.55, POP);
	const glint = prog(t, W('message') + 0.6, 1.0, Easing.linear);
	const contact = prog(t, W('set') - 0.2, 0.6);
	const Card: React.FC<{p: number; x: number; img: React.ReactNode; title: string; sub: string}> = ({p, x, img, title, sub}) => (
		<div style={{position: 'absolute', left: x, top: 280, width: 640, height: 620, borderRadius: 28, background: '#fff', boxShadow: `inset 0 0 0 1px ${B.line}, 0 40px 80px -40px rgba(120,70,20,0.45)`, overflow: 'hidden', opacity: p, transform: `translateY(${(1 - p) * 60}px)`}}>
			<div style={{height: 400, background: B.bg2, display: 'flex', alignItems: 'center', justifyContent: 'center', overflow: 'hidden'}}>{img}</div>
			<div style={{padding: '30px 40px'}}>
				<div style={{fontFamily: font, fontWeight: 800, fontSize: 38, letterSpacing: '-0.02em', color: B.ink}}>{title}</div>
				<div style={{marginTop: 10, fontFamily: font, fontWeight: 500, fontSize: 24, lineHeight: 1.35, color: B.muted}}>{sub}</div>
			</div>
		</div>
	);
	return (
		<AbsoluteFill>
			{out < 1 ? (
				<AbsoluteFill style={{opacity: 1 - out, transform: `scale(${mix(1, 0.96, out)})`}}>
					<div style={{position: 'absolute', left: 0, right: 0, top: 130, display: 'flex', flexDirection: 'column', alignItems: 'center'}}>
						<Eyebrow p={prog(t, a + 0.1, 0.5)}>Moments QR</Eyebrow>
						<div style={{marginTop: 14, fontFamily: font, fontWeight: 800, fontSize: 72, letterSpacing: '-0.03em', color: B.ink, opacity: prog(t, W('two') - 0.15, 0.5)}}>
							Two things <span style={GOLD_TEXT}>in one</span>
						</div>
					</div>
					<Card p={card1} x={250} img={<Img src={staticFile('qrh/img/qr-card.png')} style={{height: 360, borderRadius: 6, boxShadow: '0 20px 40px -20px rgba(0,0,0,0.45)', marginTop: 40}} />} title="QR codes for every event" sub="Reception, Haldi, Mehendi — each with its own card and album." />
					<div style={{position: 'absolute', left: 935, top: 545, width: 50, height: 50, borderRadius: '50%', background: `linear-gradient(135deg, ${B.goldLight}, ${B.goldDeep})`, display: 'flex', alignItems: 'center', justifyContent: 'center', fontFamily: font, fontWeight: 800, fontSize: 34, color: '#fff', opacity: card2, transform: `scale(${mix(0.4, 1, prog(t, W('own') - 0.1, 0.45, POP))})`}}>+</div>
					<Card p={card2} x={1030} img={<Img src={staticFile('qrh/img/site-hero.png')} style={{width: 640, height: 400 * 1.6, objectFit: 'cover', objectPosition: '50% 18%', marginTop: 120}} />} title="Your own wedding website" sub="Your names, story, families & events — on our signature template." />
				</AbsoluteFill>
			) : null}
			{end > 0 ? (
				<AbsoluteFill style={{opacity: end}}>
					<div style={{position: 'absolute', left: 0, right: 0, top: 120, display: 'flex', flexDirection: 'column', alignItems: 'center'}}>
						<Logo h={150} />
						<div style={{marginTop: 12, fontFamily: font, fontWeight: 700, fontSize: 34, color: B.ink}}>The Digital Moments</div>
						<div style={{marginTop: 58, fontFamily: font, fontWeight: 800, fontSize: 80, letterSpacing: '-0.035em', color: B.ink, transform: `translateY(${(1 - end) * 20}px)`}}>
							Want this for <span style={GOLD_TEXT}>your wedding?</span>
						</div>
						<div style={{marginTop: 44, position: 'relative', overflow: 'hidden', display: 'flex', alignItems: 'center', gap: 16, padding: '26px 52px', borderRadius: 999, background: `linear-gradient(135deg, ${B.gold}, ${B.goldDeep})`, color: '#fff', fontFamily: font, fontWeight: 700, fontSize: 38, boxShadow: '0 26px 50px -20px rgba(160,95,20,0.7)', opacity: Math.min(1, cta * 1.5), transform: `scale(${mix(0.7, 1, cta)})`}}>
							<svg viewBox="0 0 24 24" width={38} height={38} fill="#fff">
								<path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l.9 2.2c.1.2.1.4 0 .6l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.4 1.8 2.2 1.2 1.1 2.2 1.4 2.5 1.6.3.1.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 .9c.3.2.5.2.6.3.1.2.1.7-.1 1.3Z" />
							</svg>
							Message me “MEMORIES”
							<div style={{position: 'absolute', top: 0, bottom: 0, left: `${mix(-30, 130, glint)}%`, width: 120, background: 'linear-gradient(100deg, rgba(255,255,255,0), rgba(255,255,255,0.55), rgba(255,255,255,0))', transform: 'skewX(-20deg)'}} />
						</div>
						<div style={{marginTop: 46, display: 'flex', alignItems: 'center', gap: 40, fontFamily: font, fontWeight: 600, fontSize: 28, color: B.ink, opacity: contact}}>
							<span>+91 73308 28654</span>
							<span style={{color: B.gold}}>✦</span>
							<span>@thedigitalmoments</span>
							<span style={{color: B.gold}}>✦</span>
							<span>the-digital-moments.vercel.app</span>
						</div>
					</div>
					<div style={{position: 'absolute', left: 0, right: 0, bottom: 60, display: 'flex', justifyContent: 'center', opacity: contact}}>
						<div style={{display: 'flex', alignItems: 'center', gap: 16, padding: '10px 26px 10px 10px', borderRadius: 999, background: '#fff', boxShadow: `inset 0 0 0 1px ${B.line}`}}>
							<Img src={staticFile('qrh/img/founder.png')} style={{width: 64, height: 64, borderRadius: '50%', boxShadow: `0 0 0 3px ${B.gold}`}} />
							<div style={{fontFamily: font}}>
								<div style={{fontWeight: 800, fontSize: 24, color: B.ink}}>Venkatesh Yarramsetti</div>
								<div style={{fontWeight: 600, fontSize: 18, color: B.copper}}>Founder, The Digital Moments</div>
							</div>
						</div>
					</div>
				</AbsoluteFill>
			) : null}
		</AbsoluteFill>
	);
};

// ── film ────────────────────────────────────────────────────────────────────────────────────────────

/** Left-to-right reveal with a soft gold edge. */
const Wipe: React.FC<{t: number; at: number; children: React.ReactNode}> = ({t, at, children}) => {
	const p = prog(t, at, 0.75, IN_OUT);
	if (p >= 1) return <AbsoluteFill>{children}</AbsoluteFill>;
	const x = p * 2100 - 90;
	return (
		<AbsoluteFill>
			<AbsoluteFill style={{clipPath: `inset(0 ${Math.max(0, 1920 - x)}px 0 0)`}}>{children}</AbsoluteFill>
			<div style={{position: 'absolute', top: 0, bottom: 0, left: x - 60, width: 70, background: `linear-gradient(to right, rgba(217,160,69,0), rgba(240,196,106,0.85), rgba(217,160,69,0))`, opacity: Math.sin(Math.PI * p)}} />
		</AbsoluteFill>
	);
};

export const MomentsQrHowItWorks: React.FC<HiwProps> = ({parts, duration, segments, musicOffset}) => {
	const t = useCurrentFrame() / FPS;
	const c = useTimes(parts);
	const at = (id: string) => c.P(id).start - 0.55;
	const scenes: {a: number; el: (sp: SP) => React.ReactNode; step: number}[] = [
		{a: 0, el: (sp) => <SceneIntro {...sp} />, step: -1},
		{a: at('h1'), el: (sp) => <SceneCreate {...sp} />, step: 0},
		{a: at('h2'), el: (sp) => <SceneScan {...sp} />, step: 1},
		{a: at('h3'), el: (sp) => <SceneUpload {...sp} />, step: 2},
		{a: at('h4'), el: (sp) => <SceneSite {...sp} />, step: 3},
		{a: at('h5'), el: (sp) => <SceneEnd {...sp} />, step: -1},
	];
	const cur = scenes.filter((s) => t >= s.a).length - 1;
	const step = scenes[Math.max(0, cur)].step;
	const cornerO = prog(t, c.W('h0', 'hi') - 0.2, 0.6) * (1 - prog(t, c.W('h5', 'want') - 0.4, 0.5));
	return (
		<AbsoluteFill style={{background: B.bg}}>
			<Backdrop t={t} />
			{scenes.map((s, i) => {
				const next = scenes[i + 1];
				if (t < s.a || (next && t > next.a + 0.8)) return null;
				const b = next ? next.a : duration;
				const body = s.el({t, c, a: s.a, b});
				return i === 0 ? (
					<AbsoluteFill key={i}>{body}</AbsoluteFill>
				) : (
					<Wipe key={i} t={t} at={s.a}>
						<AbsoluteFill style={{background: B.bg}}>
							<Backdrop t={t} />
							{body}
						</AbsoluteFill>
					</Wipe>
				);
			})}
			<Corner o={cornerO} />
			<Tracker active={step} o={step >= 0 ? prog(t, scenes[cur].a + 0.3, 0.5) : step === -1 && cur === 5 ? 1 - prog(t, scenes[5].a, 0.4) : 0} />
			<AbsoluteFill style={{background: '#000', opacity: prog(t, duration - 0.6, 0.6, Easing.linear)}} />
			<Soundtrack duration={duration} segments={segments} musicOffset={musicOffset} wipes={scenes.slice(1).map((s) => s.a)} cues={{logo: 0.3, cta: c.W('h5', 'message')}} voEnd={parts.length ? parts[parts.length - 1].end : 0} />
		</AbsoluteFill>
	);
};

const MUSIC = {intro: 0.17, voice: 0.06, gap: 0.1, end: 0.22};
const Soundtrack: React.FC<{duration: number; musicOffset: number; voEnd: number; segments: {s: number; e: number}[]; wipes: number[]; cues: {logo: number; cta: number}}> = ({duration, musicOffset, voEnd, segments, wipes, cues}) => {
	const speech = (t: number) => Math.max(0, ...segments.map((g) => prog(t, g.s - 0.2, 0.2, Easing.linear) * (1 - prog(t, g.e, 0.35, Easing.linear))));
	const first = segments.length ? segments[0].s : 0;
	const musicVol = (f: number) => {
		const t = f / FPS;
		const body = t > voEnd ? mix(MUSIC.gap, MUSIC.end, prog(t, voEnd, 0.8, Easing.linear)) : mix(MUSIC.gap, MUSIC.voice, speech(t));
		const level = t < first - 0.3 ? MUSIC.intro : body;
		return level * prog(t, 0, 0.2, Easing.linear) * (1 - prog(t, duration - 2.4, 2.4, Easing.linear));
	};
	const sfx: [number, string, number][] = [[cues.logo, 'harp-reveal', 0.1], ...wipes.map((a): [number, string, number] => [a - 0.05, 'silk-swish', 0.13]), [cues.cta - 0.15, 'soft-chime', 0.28]];
	return (
		<>
			<Audio src={staticFile('qrh/music.mp3')} startFrom={Math.round(musicOffset * FPS)} volume={musicVol} />
			<Audio src={staticFile('qrh/narration.wav')} volume={1.0} />
			{sfx.map(([at, name, v], i) => (
				<Sequence key={i} from={Math.max(0, Math.round(at * FPS))} durationInFrames={Math.round(3 * FPS)} layout="none">
					<Audio src={staticFile(`qrh/sfx/${name}.mp3`)} volume={(f) => v * interpolate(f, [70, 90], [1, 0], {extrapolateLeft: 'clamp', extrapolateRight: 'clamp'})} />
				</Sequence>
			))}
		</>
	);
};
